// Prisma schema — PharmaLab ERP (simplified redesign)
// 6 actors: admin, stock_manager, production_manager,
//           purchase_manager, quality_manager, sales_manager

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STOCK_MANAGER
  PRODUCTION_MANAGER
  PURCHASE_MANAGER
  QUALITY_MANAGER
  SALES_MANAGER
}

enum ProductCategory {
  FINISHED_PRODUCT
  RAW_MATERIAL
}

enum BatchType {
  LOT
  RM
}

enum BatchStatus {
  IN_PROGRESS    // raw production batch in workshop
  PENDING_QC     // closed/received, awaiting QC
  VALIDATED      // released to stock
  REJECTED       // blocked
  IN_PRODUCTION  // raw material being consumed in MO
}

enum MovementType {
  ENTRY
  EXIT
}

enum ManufacturingStatus {
  IN_PROGRESS
  PENDING_QC
  CLOSED
}

enum PurchaseStatus {
  SENT
  IN_PROGRESS
  RECEIVED
}

enum QCResult {
  VALIDATED
  REJECTED
}

enum QCOrigin {
  PRODUCTION
  PURCHASE
}

enum SalesStatus {
  PENDING
  CONFIRMED
  DELIVERED
}

enum DeliveryStatus {
  PREPARED
  SHIPPED
  DELIVERED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

// ─────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  fullName     String
  email        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())

  productsCreated     Product[]
  manufacturingOrders ManufacturingOrder[]
  purchaseOrders      PurchaseOrder[]
  qualityControls     QualityControl[]
  salesOrders         SalesOrder[]
  stockMovements      StockMovement[]
  refreshTokens       RefreshToken[]
  passwordResets      PasswordReset[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tempHash  String
  used      Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────────────────────

model Product {
  id            Int             @id @default(autoincrement())
  name          String
  category      ProductCategory
  unit          String
  minStockLevel Float           @default(0)
  createdById   Int
  createdAt     DateTime        @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  batches             Batch[]
  manufacturingOrders ManufacturingOrder[]
  purchaseOrders      PurchaseOrder[]
  salesOrderItems     SalesOrderItem[]

  @@index([category])
}

// ─────────────────────────────────────────────────────────────
// SUPPLIERS / CLIENTS
// ─────────────────────────────────────────────────────────────

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  salesOrders SalesOrder[]
}

// ─────────────────────────────────────────────────────────────
// BATCHES
// ─────────────────────────────────────────────────────────────

model Batch {
  id              Int         @id @default(autoincrement())
  batchNumber     String      @unique // LOT-YYYY-XXX or RM-YYYY-XXX
  productId       Int
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantity        Float
  status          BatchStatus
  batchType       BatchType
  origin          QCOrigin // PRODUCTION or PURCHASE
  createdAt       DateTime    @default(now())

  product Product @relation(fields: [productId], references: [id])

  manufacturingOrder ManufacturingOrder?
  purchaseOrder      PurchaseOrder?
  qualityControls    QualityControl[]
  movements          StockMovement[]
  salesOrderItems    SalesOrderItem[]

  @@index([productId])
  @@index([status])
  @@index([batchType])
}

// ─────────────────────────────────────────────────────────────
// STOCK MOVEMENTS
// ─────────────────────────────────────────────────────────────

model StockMovement {
  id       Int          @id @default(autoincrement())
  batchId  Int
  type     MovementType
  quantity Float
  date     DateTime     @default(now())
  reason   String?
  userId   Int

  batch Batch @relation(fields: [batchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([batchId])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────
// MANUFACTURING ORDERS
// ─────────────────────────────────────────────────────────────

model ManufacturingOrder {
  id          Int                 @id @default(autoincrement())
  orderNumber String              @unique // MO-YYYY-XXX
  productId   Int
  plannedDate DateTime
  quantity    Float
  status      ManufacturingStatus @default(IN_PROGRESS)
  batchId     Int?                @unique
  userId      Int
  reworkOfId  Int?                @unique
  createdAt   DateTime            @default(now())

  product  Product @relation(fields: [productId], references: [id])
  user     User    @relation(fields: [userId], references: [id])
  batch    Batch?  @relation(fields: [batchId], references: [id])
  reworkOf ManufacturingOrder?  @relation("Rework", fields: [reworkOfId], references: [id])
  reworked ManufacturingOrder?  @relation("Rework")
}

// ─────────────────────────────────────────────────────────────
// PURCHASE ORDERS
// ─────────────────────────────────────────────────────────────

model PurchaseOrder {
  id          Int            @id @default(autoincrement())
  orderNumber String         @unique // PO-YYYY-XXX
  supplierId  Int
  productId   Int
  quantity    Float
  orderDate   DateTime       @default(now())
  status      PurchaseStatus @default(SENT)
  batchId     Int?           @unique
  userId      Int
  createdAt   DateTime       @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  batch    Batch?   @relation(fields: [batchId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// QUALITY CONTROL
// ─────────────────────────────────────────────────────────────

model QualityControl {
  id          Int       @id @default(autoincrement())
  batchId     Int
  controlDate DateTime  @default(now())
  result      QCResult
  notes       String?
  userId      Int
  origin      QCOrigin

  batch Batch @relation(fields: [batchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([batchId])
}

// ─────────────────────────────────────────────────────────────
// SALES
// ─────────────────────────────────────────────────────────────

model SalesOrder {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique // SO-YYYY-XXX
  clientId    Int
  orderDate   DateTime    @default(now())
  status      SalesStatus @default(PENDING)
  totalAmount Float       @default(0)
  userId      Int
  createdAt   DateTime    @default(now())

  client       Client           @relation(fields: [clientId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  items        SalesOrderItem[]
  deliveryNote DeliveryNote?
}

model SalesOrderItem {
  id           Int   @id @default(autoincrement())
  salesOrderId Int
  batchId      Int
  productId    Int
  quantity     Float

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  batch      Batch      @relation(fields: [batchId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
}

model DeliveryNote {
  id           Int            @id @default(autoincrement())
  noteNumber   String         @unique // DN-YYYY-XXX
  salesOrderId Int            @unique
  deliveryDate DateTime       @default(now())
  status       DeliveryStatus @default(PREPARED)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Notification {
  id            Int              @id @default(autoincrement())
  recipientRole Role
  message       String
  type          NotificationType @default(INFO)
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  relatedId     Int?
  relatedType   String?

  @@index([recipientRole, isRead])
}
