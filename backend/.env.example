# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL recommended for transactions/concurrency)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_pharm?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
